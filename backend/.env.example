# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_NAME="Doctor Qualification API"

# Vergul bilan ajratiladi. Development'da har qanday localhost portiga
# avtomatik ruxsat beriladi, productionda faqat shu ro'yxat ishlaydi.
CORS_ORIGIN=http://localhost:5173

# Sertifikat QR kodi shu manzilga ishora qiladi (frontend bazasi).
PUBLIC_APP_URL=http://localhost:5173

# ─── Database (Neon / Supabase / boshqa cloud Postgres) ──────────────────────
# DATABASE_URL — runtime uchun POOLED ulanish (host nomida "-pooler" bo'ladi).
# DIRECT_URL   — migration va seed uchun TO'G'RIDAN-TO'G'RI ulanish (pooler'siz).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/dbname?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Kamida 32 ta belgi. Generatsiya: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=1d

# ─── Rate limit ──────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# ─── Fayl yuklash ────────────────────────────────────────────────────────────
# Avatar rasmlari shu papkaga saqlanadi va /uploads orqali beriladi.
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
