generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DOCTOR
}

model User {
  id       Int      @id @default(autoincrement())
  fullname String   @db.VarChar(100)
  email    String   @unique @db.VarChar(255)
  password String
  role     UserRole @default(DOCTOR)
  isActive Boolean  @default(true)

  /// Yuklangan rasmga nisbiy yo'l: /uploads/avatars/<fayl>.
  avatarUrl String? @db.VarChar(255)

  doctorProfile DoctorProfile?
  notifications Notification[]
  announcements Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

/// Shifokorga xos ma'lumotlar auth identifikatoridan ajratilgan —
/// ADMIN hisoblarida bu yozuv umuman bo'lmaydi.
model DoctorProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialtyId Int?
  specialty   Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)

  phone           String? @db.VarChar(32)
  workplace       String? @db.VarChar(160)
  experienceYears Int?

  attempts     ExamAttempt[]
  certificates Certificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([specialtyId])
}

/// Mutaxassislik — savol bazasi va imtihonlar shu bo'yicha ajratiladi.
model Specialty {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(300)
  isActive    Boolean @default(true)

  doctorProfiles DoctorProfile[]
  exams          Exam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, name])
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

/// Savol bazasi. Javob variantlari `QuestionOption` ichida saqlanadi va
/// `isCorrect` mijozga hech qachon yuborilmaydi (PrismaService `omit`).
model Question {
  id         Int        @id @default(autoincrement())
  examId     Int
  exam       Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  text       String     @db.VarChar(1000)
  difficulty Difficulty
  position   Int
  isActive   Boolean    @default(true)

  options  QuestionOption[]
  attempts AttemptQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, position])
  @@index([examId, isActive])
}

model QuestionOption {
  id         Int      @id @default(autoincrement())
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String   @db.VarChar(500)
  isCorrect  Boolean  @default(false)
  position   Int

  @@unique([questionId, position])
}

/// Imtihon — o'z savollar to'plamiga ega. Har bir urinishda shu to'plamdan
/// `questionCount` ta savol tasodifiy tanlanadi.
model Exam {
  id          Int     @id @default(autoincrement())
  specialtyId Int
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  title       String  @db.VarChar(160)
  description String? @db.VarChar(500)

  questionCount    Int
  timeLimitMinutes Int
  passingScore     Int

  isActive Boolean @default(true)

  questions Question[]
  attempts  ExamAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([specialtyId, isActive])
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum QualificationLevel {
  BEGINNER
  INTERMEDIATE
  GOOD
  HIGH
  EXPERT
}

/// Bitta imtihon urinishi. Sozlama qiymatlari (savollar soni, vaqt, o'tish bali)
/// urinish boshlanganda nusxalanadi — keyin imtihon tahrirlansa ham tarixiy
/// natija o'zgarmaydi.
model ExamAttempt {
  id     Int  @id @default(autoincrement())
  examId Int
  exam   Exam @relation(fields: [examId], references: [id], onDelete: Restrict)

  doctorProfileId Int
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  status AttemptStatus @default(IN_PROGRESS)

  questionCount    Int
  timeLimitMinutes Int
  passingScore     Int

  startedAt   DateTime  @default(now())
  deadlineAt  DateTime
  completedAt DateTime?

  correctCount  Int?
  score         Int?
  qualification QualificationLevel?
  passed        Boolean?

  questions   AttemptQuestion[]
  certificate Certificate?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorProfileId, startedAt])
  @@index([examId])
  @@index([status])
}

/// Urinishga tanlangan savolning nusxasi. Manba savol keyin tahrirlansa yoki
/// o'chirilsa ham shu yozuv o'zgarmaydi.
model AttemptQuestion {
  id        Int         @id @default(autoincrement())
  attemptId Int
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  /// Manba savol — faqat ma'lumot uchun, o'chirilsa `null` bo'ladi.
  questionId Int?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  position     Int
  questionText String     @db.VarChar(1000)
  difficulty   Difficulty

  selectedOptionId Int?           @unique
  selectedOption   AttemptOption? @relation("SelectedOption", fields: [selectedOptionId], references: [id], onDelete: SetNull)

  isCorrect Boolean?

  options AttemptOption[] @relation("QuestionOptions")

  @@unique([attemptId, position])
}

/// Javob variantining nusxasi. `isCorrect` global `omit` bilan yopilgan —
/// imtihon davomida mijozga hech qachon yuborilmaydi.
model AttemptOption {
  id                Int             @id @default(autoincrement())
  attemptQuestionId Int
  attemptQuestion   AttemptQuestion @relation("QuestionOptions", fields: [attemptQuestionId], references: [id], onDelete: Cascade)

  position  Int
  text      String  @db.VarChar(500)
  isCorrect Boolean

  selectedBy AttemptQuestion? @relation("SelectedOption")

  @@unique([attemptQuestionId, position])
}

enum CertificateStatus {
  ACTIVE
  REVOKED
}

/// Sertifikat mazmuni berilgan paytda nusxalanadi — shifokor profili yoki
/// imtihon nomi keyin o'zgarsa ham berilgan hujjat o'zgarmaydi.
model Certificate {
  id            Int    @id @default(autoincrement())
  /// Ommaviy tekshiruv identifikatori: DOC-2026-000123
  certificateId String @unique @db.VarChar(32)

  attemptId Int         @unique
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  doctorProfileId Int
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)

  doctorFullname String             @db.VarChar(100)
  specialtyName  String             @db.VarChar(100)
  examTitle      String             @db.VarChar(160)
  score          Int
  qualification  QualificationLevel

  status        CertificateStatus @default(ACTIVE)
  issuedAt      DateTime          @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?           @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorProfileId, issuedAt])
  @@index([status])
}

enum NotificationType {
  EXAM_PUBLISHED
  CERTIFICATE_ISSUED
  CERTIFICATE_REVOKED
  SYSTEM
}

/// Foydalanuvchiga yo'naltirilgan bitta xabar. Matn yozilgan paytda
/// nusxalanadi — manba imtihon yoki sertifikat keyin o'zgarsa ham
/// xabar tarixi o'zgarmaydi.
model Notification {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   NotificationType
  title  String           @db.VarChar(200)
  body   String           @db.VarChar(500)
  link   String?          @db.VarChar(255)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// Admin yuborgan ommaviy xabar. Har bir qabul qiluvchiga alohida
/// `Notification` yoziladi, bu jadval esa yuborish tarixini saqlaydi.
model Announcement {
  id    Int     @id @default(autoincrement())
  title String  @db.VarChar(200)
  body  String  @db.VarChar(500)
  link  String? @db.VarChar(255)

  /// Qabul qiluvchilar filtri o'qiladigan matn ko'rinishida saqlanadi —
  /// mutaxassislik nomi keyin o'zgarsa ham yuborilgan xabar tarixi o'zgarmaydi.
  audience       String @db.VarChar(200)
  recipientCount Int

  sentById Int?
  sentBy   User? @relation(fields: [sentById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Administrator o'zgartira oladigan platforma sozlamalari — yagona qatorda
/// saqlanadi. Malaka darajasi chegaralari va sertifikat raqami formati bu
/// yerga kiritilmagan: ular berilgan hujjatlarga yozilgan va o'zgarmasligi kerak.
model PlatformSettings {
  id Int @id @default(1)

  /// Reyting bali vaznlari — yig'indisi 1 ga teng bo'lishi shart emas,
  /// muhimi kamida bittasi noldan katta bo'lsin.
  averageScoreWeight   Float @default(0.5)
  bestScoreWeight      Float @default(0.2)
  volumeWeight         Float @default(0.2)
  passRateWeight       Float @default(0.1)
  volumeTargetAttempts Int   @default(5)

  /// Yangi beriladigan sertifikatlar uchun amal qilish muddati (oy).
  /// Allaqachon berilgan sertifikatlarning muddati o'zgarmaydi.
  certificateValidityMonths Int @default(12)

  /// Yangi imtihon formasi shu qiymatlar bilan to'ldiriladi.
  defaultQuestionCount    Int @default(10)
  defaultTimeLimitMinutes Int @default(20)
  defaultPassingScore     Int @default(60)

  updatedAt DateTime @updatedAt
}
