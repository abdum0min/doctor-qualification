generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DOCTOR
}

model User {
  id       Int      @id @default(autoincrement())
  fullname String   @db.VarChar(100)
  email    String   @unique @db.VarChar(255)
  password String
  role     UserRole @default(DOCTOR)
  isActive Boolean  @default(true)

  doctorProfile DoctorProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

/// Shifokorga xos ma'lumotlar auth identifikatoridan ajratilgan —
/// ADMIN hisoblarida bu yozuv umuman bo'lmaydi.
model DoctorProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialtyId Int?
  specialty   Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)

  phone           String? @db.VarChar(32)
  workplace       String? @db.VarChar(160)
  experienceYears Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([specialtyId])
}

/// Mutaxassislik — savol bazasi va imtihonlar shu bo'yicha ajratiladi.
model Specialty {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(300)
  isActive    Boolean @default(true)

  doctorProfiles DoctorProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, name])
}
