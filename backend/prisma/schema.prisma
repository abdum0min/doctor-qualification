generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DOCTOR
}

model User {
  id       Int      @id @default(autoincrement())
  fullname String   @db.VarChar(100)
  email    String   @unique @db.VarChar(255)
  password String
  role     UserRole @default(DOCTOR)
  isActive Boolean  @default(true)

  doctorProfile DoctorProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

/// Shifokorga xos ma'lumotlar auth identifikatoridan ajratilgan —
/// ADMIN hisoblarida bu yozuv umuman bo'lmaydi.
model DoctorProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialtyId Int?
  specialty   Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)

  phone           String? @db.VarChar(32)
  workplace       String? @db.VarChar(160)
  experienceYears Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([specialtyId])
}

/// Mutaxassislik — savol bazasi va imtihonlar shu bo'yicha ajratiladi.
model Specialty {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(300)
  isActive    Boolean @default(true)

  doctorProfiles DoctorProfile[]
  questions      Question[]
  exams          Exam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, name])
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

/// Savol bazasi. Javob variantlari `QuestionOption` ichida saqlanadi va
/// `isCorrect` mijozga hech qachon yuborilmaydi (PrismaService `omit`).
model Question {
  id          Int        @id @default(autoincrement())
  specialtyId Int
  specialty   Specialty  @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  text        String     @db.VarChar(1000)
  difficulty  Difficulty
  isActive    Boolean    @default(true)

  options QuestionOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([specialtyId, difficulty, isActive])
  @@index([createdAt])
}

model QuestionOption {
  id         Int      @id @default(autoincrement())
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String   @db.VarChar(500)
  isCorrect  Boolean  @default(false)
  position   Int

  @@unique([questionId, position])
}

/// Imtihon konfiguratsiyasi. Savollar har bir urinishda shu sozlama asosida
/// bazadan tanlanadi — imtihonga qat'iy savollar biriktirilmaydi.
model Exam {
  id          Int     @id @default(autoincrement())
  specialtyId Int
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  title       String  @db.VarChar(160)
  description String? @db.VarChar(500)

  questionCount    Int
  timeLimitMinutes Int
  passingScore     Int
  /// `null` — barcha darajalardagi savollar aralash tanlanadi.
  difficulty       Difficulty?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([specialtyId, isActive])
}
